                            if type(weapon)=="table" and weapon.model and (weapon.weaponValue==equipped or equipped and equipped.Name==weapon.weaponName) then
                                for _,object in ipairs(weapon.model:GetDescendants()) do
                                    if object:IsA("Attachment") and object.Name:lower():find("muzzle",1,true) then muzzle=object;break end
                                end
                            end
                            if muzzle then muzzleFrame=muzzle.WorldCFrame;break end
                            if type(weapon)=="table" and weapon.weaponValue==equipped and weapon.modelClient then
                                local tip=weapon.modelClient.muzzlePart
                                local grip=weapon.primaryPart
                                if tip and grip then
                                    local direction=tip.Position-grip.Position
                                    if direction.Magnitude>.01 then muzzleFrame=CFrame.lookAt(tip.Position,tip.Position+direction);break end
                                end
                            end
                        end
                        if muzzleFrame then
                            local frame=muzzleFrame
                            local delta=root.Position-frame.Position
                            local along=delta:Dot(frame.LookVector)
                            local lateral=(delta-frame.LookVector*along).Magnitude
                            if along>0 and lateral<math.max(3,along*.025) then
                                local ignore={character,workspace.CurrentCamera}
                                if model.weaponsModel then table.insert(ignore,model.weaponsModel) end
                                params.FilterDescendantsInstances=ignore
                                local hit=workspace:Raycast(frame.Position,delta,params)
                                if not hit or hit.Instance:IsDescendantOf(own) then
                                    active[player]=true
                                    local marker=X.aimLabels[player]
                                    if not marker then
                                        marker=make("BillboardGui",{Name="ModenaAimWarning",Size=UDim2.fromOffset(230,46),StudsOffsetWorldSpace=Vector3.new(0,3,0),AlwaysOnTop=true},gui)
                                        local caption=label(player.DisplayName.."\nAIMING AT YOU?",marker,UDim2.fromScale(1,1))
                                        caption.TextColor3=Color3.fromRGB(255,65,65);caption.TextStrokeTransparency=.2;caption.TextXAlignment=Enum.TextXAlignment.Center;caption.TextSize=13
                                        X.aimLabels[player]=marker
                                    end
                                    marker.Adornee=head
                                end
                            end
                        end
                    end
                end
            end
        end
        for player,marker in pairs(X.aimLabels) do if not active[player] then marker:Destroy();X.aimLabels[player]=nil end end
    end)
end

