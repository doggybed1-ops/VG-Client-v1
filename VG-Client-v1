    local options=make("ScrollingFrame",{Position=UDim2.fromOffset(0,60),Size=UDim2.new(1,0,0,180),
        BackgroundColor3=Color3.fromRGB(14,17,22),BorderSizePixel=0,ScrollBarThickness=3,ZIndex=5,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),Visible=false},row)
    make("UIListLayout",{Padding=UDim.new(0,2)},options)
    local opened=false
    local function populate()
        for _,child in ipairs(options:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
        local ok,entries=pcall(provider)
        if not ok then X.note(entries);entries={} end
        local count=0
        for _,entry in ipairs(entries) do
            if search.Text=="" or entry.label:lower():find(search.Text:lower(),1,true) then
                count+=1
                local item=button(entry.label,options);item.TextSize=11;item.Size=UDim2.new(1,-6,0,34)
                item.MouseButton1Click:Connect(function()
                    local success,err=pcall(onSelect,entry.value,entry.label)
                    if not success then X.note(err);return end
                    head.Text=entry.label.."  v";opened=false;search.Visible=false;options.Visible=false;row.Size=UDim2.new(1,-6,0,30)
                end)
            end
        end
        if count==0 then label("No matching entries",options) end
    end
    head.MouseButton1Click:Connect(function()
        opened=not opened;search.Visible=opened;options.Visible=opened;row.Size=UDim2.new(1,-6,0,opened and 242 or 30)
        if opened then search.Text="";populate() end
    end)
    connect(search:GetPropertyChangedSignal("Text"),function() if opened then populate() end end)
    return {row=row,head=head,refresh=populate}
end

