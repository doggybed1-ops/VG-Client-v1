local AUTH_URL = "http://78.154.103.42:10263/auth"
local KEY_FILE = "Modena Client/key.txt"

local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")

local function getHWID()
    local ok, result = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    return ok and result or "unknown"
end

local function saveKey(key)
    if writefile then pcall(writefile, KEY_FILE, key) end
end

local function loadKey()
    if isfile and isfile(KEY_FILE) then
        local ok, content = pcall(readfile, KEY_FILE)
        if ok then return content:gsub("%s+", "") end
    end
    return nil
end

local function authenticate(key)
    local body = HttpService:JSONEncode({key = key, hwid = getHWID()})
    local req = (syn and syn.request) or request or http_request or (http and http.request)
    if not req then return false, "No HTTP support" end

    local ok, res = pcall(function()
        return req({
            Url = AUTH_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = body
        })
    end)

    if not ok or not res then return false, "Could not reach server" end
    if res.StatusCode ~= 200 then return false, "Server error " .. tostring(res.StatusCode) end

    local data
    local success = pcall(function() data = HttpService:JSONDecode(res.Body) end)
    if not success or type(data) ~= "table" then return false, "Bad response" end
    return data.success == true, data.message or "Failed"
end

