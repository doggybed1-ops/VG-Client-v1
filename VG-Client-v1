section("Barrux","Choose an individual ESP marker or teleport destination.")
local poiStatus=label("Live objects • missing destinations are marked unavailable",list,UDim2.new(1,-6,0,40))
poiStatus.TextSize=11
local poiVisuals={}
local function resolveBarrux(entry)
    if entry.object and entry.object:IsDescendantOf(workspace) then return entry.object end
    local object=workspace
    for i,name in ipairs(entry.path) do
        if i==#entry.path then
            local matches={}
            for _,child in ipairs(object:GetChildren()) do if child.Name==name then table.insert(matches,child) end end
            object=matches[entry.ordinal]
        else object=object:FindFirstChild(name) end
        if not object then return nil end
    end
    entry.object=object
    return object
end
local function barruxAnchor(entry)
    local object=resolveBarrux(entry)
    if not object then return end
    if object:IsA("BasePart") then return object,object end
    if entry.anchor and entry.anchor:IsDescendantOf(object) then return entry.anchor,object end
    local part=object:IsA("Model") and (object.PrimaryPart or object:FindFirstChild("HumanoidRootPart")) or nil
    part=part or object:FindFirstChildWhichIsA("BasePart",true)
    entry.anchor=part
    return part,object
end
local function removePoiVisual(entry)
    local visual=poiVisuals[entry]
    if visual then visual.label:Destroy();if visual.highlight then visual.highlight:Destroy() end;poiVisuals[entry]=nil end
end
local function destinationFor(entry)
    local part,object=barruxAnchor(entry)
    assert(part,"Destination is not loaded")
    local char=P.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    assert(root and hum and hum.Health>0,"Spawn before teleporting")
    local position=part.Position+Vector3.new(6,0,0)
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
    local ignore={char}
    if object:IsA("Model") and #entry.path>2 and entry.path[2]=="FunnyLiftables" then table.insert(ignore,object) end
    params.FilterDescendantsInstances=ignore
    local ground=workspace:Raycast(position+Vector3.new(0,80,0),Vector3.new(0,-280,0),params)
    assert(ground,"No landing surface found")
    return ground.Position+Vector3.new(0,hum.HipHeight+root.Size.Y*.5+1,0),root,char
end
