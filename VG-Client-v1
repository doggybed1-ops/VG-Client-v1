-- Additional adapters are resolved by exported methods, not randomized module paths.
function X.findFunction(root,wanted)
    local seen={}
    local function visit(f,depth)
        if type(f)~="function" or seen[f] or depth>7 then return end
        seen[f]=true
        for index,value in pairs(debug.getupvalues(f)) do
            if type(value)=="function" then
                local matches=debug.info(value,"n")==wanted
                if wanted=="pilotOnPreSimulation" then
                    local hasVariables,hasHorseRay=false,false
                    for _,up in pairs(debug.getupvalues(value)) do
                        if typeof(up)=="RaycastParams" and up.CollisionGroup=="Horses" then hasHorseRay=true end
                        if type(up)=="table" then
                            local ok,loss=pcall(function() return up.HorseStaminaLoss end)
                            if ok and type(loss)=="number" then hasVariables=true end
                        end
                    end
                    matches=hasVariables and hasHorseRay
                end
                if matches then return value,f,index end
                local found,parent,slot=visit(value,depth+1)
                if found then return found,parent,slot end
            end
        end
    end
    return visit(root,0)
end
function X.replaceUpvalue(parent,index,replacement)
    local old=debug.getupvalues(parent)[index]
    debug.setupvalue(parent,index,replacement)
    table.insert(X.restores,function()
        if debug.getupvalues(parent)[index]==replacement then debug.setupvalue(parent,index,old) end
    end)
end
function X.replaceSimulation(original,parent,index,replacement,active)
    X.replaceUpvalue(parent,index,replacement)
    -- Signal connections already made by a mounted controller need their own reversible replacement.
    if type(getconnections)=="function" and active() then
        for _,connection in ipairs(getconnections(Run.PreSimulation)) do
            if connection.Function==original and connection.Enabled then
                connection:Disable()
                local replacementConnection=Run.PreSimulation:Connect(function(dt)
                    if alive and active() then replacement(dt) end
                end)
                table.insert(X.restores,function()
                    replacementConnection:Disconnect()
                    if active() then pcall(function() connection:Enable() end) end
                end)
            end
        end
    end
end
